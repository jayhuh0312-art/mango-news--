
const CACHE_KEY = "https://mango-news-cache.internal/api/news";
const CACHE_SECONDS = 300;

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    if (url.pathname === "/api/news") {
      if (request.method !== "GET") {
        return Response.json(
          { error: "Method not allowed" },
          { status: 405 }
        );
      }

      const cache = caches.default;
      const cacheRequest = new Request(CACHE_KEY);
      const cached = await cache.match(cacheRequest);

      if (cached) {
        return new Response(cached.body, {
          status: cached.status,
          headers: cached.headers
        });
      }

      const endpoint =
        "https://api.gdeltproject.org/api/v2/doc/doc" +
        "?query=economy%20OR%20business%20OR%20technology%20OR%20science%20OR%20world" +
        "&mode=ArtList&format=json&sort=DateDesc&maxrecords=30";

      try {
        const response = await fetch(endpoint, {
          headers: { "User-Agent": "MANGO-NEWS/1.0" }
        });

        if (!response.ok) {
          return Response.json(
            { error: "News provider unavailable. Please try again later." },
            { status: 502 }
          );
        }

        const data = await response.json();

        if (!Array.isArray(data.articles)) {
          return Response.json(
            { error: "Invalid response from news provider" },
            { status: 502 }
          );
        }

        const articles = data.articles
          .map((a) => ({
            title: a.title || "",
            description: a.seendate ? `보도 날짜: ${a.seendate}` : "",
            url: a.url || "",
            domain: a.domain || "",
            date: a.seendate || ""
          }))
          .filter((a) => a.title && a.url);

        const result = Response.json(
          { articles },
          {
            headers: {
              "Cache-Control": `public, max-age=${CACHE_SECONDS}`
            }
          }
        );

        ctx.waitUntil(cache.put(cacheRequest, result.clone()));

        return result;
      } catch {
        return Response.json(
          { error: "Could not fetch news. Please try again later." },
          { status: 502 }
        );
      }
    }

    return env.ASSETS.fetch(request);
  }
};
