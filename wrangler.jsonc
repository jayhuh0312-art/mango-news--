
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mango-news",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_KV",
      "id": "ef3edbec3c3846a49151ed01e59abd7a"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
