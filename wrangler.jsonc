{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mango-news",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "assets": {
    "directory": "mango-news-upload",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
